      "Edit(//Users/darranshivdat/IdeaProjects/persona-onboarding-ref/**)",
      "Write(//Users/darranshivdat/IdeaProjects/persona-onboarding-ref/**)",
      "Read(//Users/darranshivdat/IdeaProjects/penciled-emr/voice-agent/.env*)",
      "Read(//Users/darranshivdat/IdeaProjects/penciled-emr/voice-agent/transcripts/**)",
      "Read(//Users/darranshivdat/IdeaProjects/penciled-emr/voice-agent/data/**)",
      "Read(//Users/darranshivdat/IdeaProjects/penciled-emr/voice-agent/components/**)",
      "Read(//Users/darranshivdat/IdeaProjects/penciled-emr/voice-agent/flows/**)",
      "Read(//Users/darranshivdat/IdeaProjects/penciled-emr/voice-agent/README.md)",
      "Read(//Users/darranshivdat/IdeaProjects/penciled-emr/voice-agent/KNOWN_ISSUES.md)",
      "Read(//Users/darranshivdat/IdeaProjects/penciled-emr/voice-agent/JUSTIN-WALKTHROUGH.md)",
