# Names only. Real values live in a local .env (gitignored) / host secret stores.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
DATABASE_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=      # optional; default <origin>/api/oauth/google/callback (register it in Google Cloud)
PERSONA_INTERNAL_SECRET=        # web OAuth callback -> agent POST /v1/sessions/{id}/gmail (same value on both)
PERSONA_TOKEN_ENCRYPT_KEY=      # agent only: urlsafe-base64 32 bytes (AES-GCM for Google refresh tokens); see agent/gmail/crypto.py
AGENT_API_SHARED_SECRET=
PERSONA_TRACING=noop            # noop | jsonl | langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
