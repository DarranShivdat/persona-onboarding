# All env var NAMES (no values). Generated by scripts/check-env.py --write; see docs/deploy/ENV.md.
# Per-component files: services/agent/.env.example (Fly), apps/web/.env.example (Vercel).
# Real values live in gitignored files (.persona-deploy/*.env, .persona-local/) or host secret stores.

# --- Core wiring
PERSONA_DATABASE_URL=  # required, secret, agent/local
PERSONA_AGENT_BASE_URL=  # required, web/local
PERSONA_INTERNAL_SECRET=  # required, secret, agent/web/local
AGENT_API_SHARED_SECRET=  # optional, secret, web
PERSONA_TOKEN_ENCRYPT_KEY=  # required, secret, agent/local

# --- LLM (Anthropic)
ANTHROPIC_API_KEY=  # required, secret, agent
PERSONA_EXTRACT_MODEL=  # optional, agent, default claude-haiku-4-5
PERSONA_PHRASE_MODEL=  # optional, agent, default claude-haiku-4-5
PERSONA_VOICE_LLM_MODEL=  # optional, agent, default claude-haiku-4-5

# --- Voice (Deepgram / Cartesia / call policy)
DEEPGRAM_API_KEY=  # required, secret, agent
DEEPGRAM_STT_MODEL=  # optional, agent, default nova-3
DEEPGRAM_TTS_VOICE=  # optional, agent, default aura-2-thalia-en
CARTESIA_API_KEY=  # required, secret, agent
CARTESIA_VOICE_ID=  # optional, agent, default 71a7ad14-091c-4e8e-a314-022ece01c121
CARTESIA_MODEL=  # optional, agent, default sonic-2
PERSONA_VOICE_MAX_CALL_SECS=  # optional, agent, default 900
PERSONA_VOICE_DIRECT_SPEECH=  # optional, agent, default 1
PERSONA_VOICE_FORCE_EXTRACTION=  # optional, agent, default 1
PERSONA_VOICE_QUICK_ACK=  # optional, agent, default 0
PERSONA_VOICE_QUICK_ACK_MS=  # optional, agent, default 600
PERSONA_SERVER_ICE=  # optional, agent
PERSONA_SILENCE_NUDGE_S=  # optional, agent, default 7
PERSONA_SILENCE_EXAMPLE_S=  # optional, agent, default 15
PERSONA_SILENCE_PARK_S=  # optional, agent, default 23
PERSONA_CALL_LEASE_TTL_S=  # optional, agent, default 120
PERSONA_CALL_HEARTBEAT_S=  # optional, agent, default 30
PERSONA_CALL_GRACE_S=  # optional, agent, default 20
PERSONA_WARMUP_TIMEOUT_S=  # optional, agent, default 20

# --- ICE / TURN
CLOUDFLARE_TURN_KEY_ID=  # required, agent
CLOUDFLARE_TURN_API_TOKEN=  # required, secret, agent
PERSONA_TURN_URLS=  # optional, agent
PERSONA_TURN_USERNAME=  # optional, agent
PERSONA_TURN_CREDENTIAL=  # optional, secret, agent
PERSONA_STUN_URLS=  # optional, agent, default stun:stun.l.google.com:19302
NEXT_PUBLIC_PERSONA_ICE_URLS=  # optional, web, default stun:stun.l.google.com:19302

# --- Google OAuth
GOOGLE_OAUTH_CLIENT_ID=  # required, agent/web
GOOGLE_OAUTH_CLIENT_SECRET=  # required, secret, agent/web
GOOGLE_OAUTH_REDIRECT_URL=  # optional, web, default <origin>/api/oauth/google/callback

# --- Observability (Langfuse)
PERSONA_TRACING=  # optional, agent, default noop
PERSONA_TRACE_FILE=  # optional, agent, default .persona-qa/traces.jsonl
LANGFUSE_PUBLIC_KEY=  # optional, agent
LANGFUSE_SECRET_KEY=  # optional, secret, agent
LANGFUSE_HOST=  # optional, agent, default https://cloud.langfuse.com

# --- Build identity
LOG_LEVEL=  # optional, agent, default info
GIT_SHA=  # optional, agent
PERSONA_BUILD_SHA=  # optional, web
