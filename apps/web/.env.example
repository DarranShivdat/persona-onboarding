# apps/web on Vercel — NAMES only. Generated by scripts/check-env.py --write; see docs/deploy/ENV.md.
# Fill a copy at .persona-deploy/web.env (gitignored), then scripts/deploy/vercel-web.sh.

# --- Core wiring
PERSONA_AGENT_BASE_URL=  # required
PERSONA_INTERNAL_SECRET=  # required, secret
AGENT_API_SHARED_SECRET=  # optional, secret

# --- ICE / TURN
NEXT_PUBLIC_PERSONA_ICE_URLS=  # optional, default stun:stun.l.google.com:19302

# --- Google OAuth
GOOGLE_OAUTH_CLIENT_ID=  # required
GOOGLE_OAUTH_CLIENT_SECRET=  # required, secret
GOOGLE_OAUTH_REDIRECT_URL=  # optional, default <origin>/api/oauth/google/callback

# --- Build identity
PERSONA_BUILD_SHA=  # optional
