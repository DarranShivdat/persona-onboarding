{
  "$schema": "persona-onboarding/design-tokens@1",
  "source": "docs/design/spec.md §3 (DESIGN-001). CSS mirror: docs/design/mockups/styles.css :root",
  "color": {
    "ink": "#1D1D1F",
    "ink-2": "#6E6E73",
    "ink-3": "#76767C",
    "paper": "#FFFFFF",
    "mist": "#F5F5F7",
    "line": "#E3E3E8",
    "bubble-agent": "#EDEDF0",
    "bubble-user": "#1F6FEB",
    "bubble-user-ink": "#FFFFFF",
    "signal": "#30D158",
    "signal-ink": "#1A7F37",
    "signal-wash": "#E9F9EE",
    "amber": "#FFB020",
    "amber-ink": "#8A5300",
    "amber-wash": "#FFF4DE",
    "danger": "#E5484D",
    "danger-ink": "#B42318",
    "danger-wash": "#FDECEC",
    "call-top": "#2B2D33",
    "call-bottom": "#121316",
    "call-ink": "#FFFFFF",
    "call-ink-2": "#A1A1A8",
    "focus": "#1F6FEB"
  },
  "font": {
    "family": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"SF Pro Display\", Inter, \"Helvetica Neue\", Arial, sans-serif",
    "numeric": "tabular-nums (call timer)"
  },
  "type": {
    "display": { "size": 56, "lineHeight": 1.02, "weight": 600, "tracking": "-0.035em", "mobileSize": 40 },
    "title": { "size": 28, "lineHeight": 1.15, "weight": 600 },
    "home-title": { "size": 40, "lineHeight": 1.1, "weight": 600, "tracking": "-0.03em", "mobileSize": 30 },
    "call-name": { "size": 30, "lineHeight": 1.1, "weight": 600, "tracking": "-0.02em", "mobileSize": 22 },
    "heading": { "size": 20, "lineHeight": 1.25, "weight": 600 },
    "body": { "size": 17, "lineHeight": 1.45, "weight": 400 },
    "body-strong": { "size": 17, "lineHeight": 1.45, "weight": 600 },
    "callout": { "size": 15, "lineHeight": 1.4, "weight": 400 },
    "caption": { "size": 13, "lineHeight": 1.3, "weight": 500 }
  },
  "space": { "s1": 4, "s2": 8, "s3": 12, "s4": 16, "s5": 24, "s6": 32, "s7": 48, "s8": 64 },
  "radius": { "bubble": 20, "bubble-tail": 6, "card": 20, "tile": 14, "pill": 999, "device": 44 },
  "shadow": {
    "card": "0 1px 2px rgba(29,29,31,.06), 0 8px 24px rgba(29,29,31,.06)",
    "device": "0 24px 60px rgba(18,19,22,.28), 0 2px 6px rgba(18,19,22,.18)"
  },
  "ring": {
    "idle": { "border": "rgba(255,255,255,.28)", "width": 4, "glow": "none" },
    "ringing": { "border": "#30D158", "width": 4, "motion": "halo pulse 1.6s ease-in-out infinite" },
    "speaking": { "border": "#30D158", "width": 6, "motion": "glow scales with agent output level, 120ms smoothing" },
    "listening": { "border": "#30D158", "width": 4, "motion": "static glow" },
    "muted": { "border": "#A1A1A8", "width": 4, "glow": "none" },
    "reconnecting": { "border": "#FFB020", "style": "dashed", "width": 4, "motion": "rotate 2.4s linear infinite" },
    "ended": { "border": "rgba(255,255,255,.18)", "width": 4, "glow": "none" }
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "ease-out": "cubic-bezier(.2,.8,.2,1)",
    "ease-in-out": "cubic-bezier(.4,0,.2,1)",
    "message-in": "opacity 0→1 + translateY 6px→0, base, ease-out",
    "card-in": "opacity 0→1 + scale .98→1, slow, ease-out",
    "check-fill": "bar width 0→100%, slow, ease-out; item bg signal-wash for 1600ms",
    "typing-dots": "3 dots, 1.2s staggered opacity",
    "reduced-motion": "all of the above become instant; ring uses opacity-only state changes"
  },
  "layout": {
    "breakpoint-mobile-max": 767,
    "topbar-height": { "desktop": 64, "mobile": 56 },
    "chat-column-max": 680,
    "call-rail-width": 440,
    "device": { "width": 360, "height": 740, "maxHeight": "calc(100vh - 112px)" },
    "gmail-card-max": 440,
    "home-column-max": 760,
    "hit-target-min": 44,
    "viewports": { "desktop": [1440, 900], "mobile": [390, 844] }
  }
}
