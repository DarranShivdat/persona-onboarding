# services/agent on Fly.io — NAMES only. Generated by scripts/check-env.py --write; see docs/deploy/ENV.md.
# Fill a copy at .persona-deploy/agent.env (gitignored), then scripts/deploy/fly-agent.sh.

# --- Core wiring
PERSONA_DATABASE_URL=  # required, secret
PERSONA_INTERNAL_SECRET=  # required, secret
PERSONA_TOKEN_ENCRYPT_KEY=  # required, secret

# --- LLM (Anthropic)
ANTHROPIC_API_KEY=  # required, secret
PERSONA_EXTRACT_MODEL=  # optional, default claude-haiku-4-5
PERSONA_PHRASE_MODEL=  # optional, default claude-haiku-4-5
PERSONA_VOICE_LLM_MODEL=  # optional, default claude-haiku-4-5

# --- Voice (Deepgram / Cartesia / call policy)
DEEPGRAM_API_KEY=  # required, secret
DEEPGRAM_STT_MODEL=  # optional, default nova-3
DEEPGRAM_TTS_VOICE=  # optional, default aura-2-thalia-en
CARTESIA_API_KEY=  # required, secret
CARTESIA_VOICE_ID=  # optional, default 71a7ad14-091c-4e8e-a314-022ece01c121
CARTESIA_MODEL=  # optional, default sonic-2
PERSONA_VOICE_MAX_CALL_SECS=  # optional, default 900
PERSONA_SILENCE_NUDGE_S=  # optional, default 7
PERSONA_SILENCE_EXAMPLE_S=  # optional, default 15
PERSONA_SILENCE_PARK_S=  # optional, default 23
PERSONA_CALL_LEASE_TTL_S=  # optional, default 120
PERSONA_CALL_HEARTBEAT_S=  # optional, default 30
PERSONA_CALL_GRACE_S=  # optional, default 20

# --- ICE / TURN
CLOUDFLARE_TURN_KEY_ID=  # required
CLOUDFLARE_TURN_API_TOKEN=  # required, secret
PERSONA_TURN_URLS=  # optional
PERSONA_TURN_USERNAME=  # optional
PERSONA_TURN_CREDENTIAL=  # optional, secret
PERSONA_STUN_URLS=  # optional, default stun:stun.l.google.com:19302

# --- Google OAuth
GOOGLE_OAUTH_CLIENT_ID=  # required
GOOGLE_OAUTH_CLIENT_SECRET=  # required, secret

# --- Observability (Langfuse)
PERSONA_TRACING=  # optional, default noop
PERSONA_TRACE_FILE=  # optional, default .persona-qa/traces.jsonl
LANGFUSE_PUBLIC_KEY=  # optional
LANGFUSE_SECRET_KEY=  # optional, secret
LANGFUSE_HOST=  # optional, default https://cloud.langfuse.com

# --- Build identity
GIT_SHA=  # optional
